# Public browser configuration. Convex writes the real value to .env.local.
VITE_CONVEX_URL=https://your-deployment.convex.cloud
VITE_SEPOLIA_RPC_URL=https://your-sepolia-rpc.example

# Non-secret World identifiers. Install these in Convex with `pnpm convex env set`.
WORLD_SPIKE_ENABLED=false
WORLD_APP_ID=app_your_app_id
WORLD_RP_ID=rp_your_rp_id
WORLD_ACTION=startup-on-fire-phase-1
WORLD_ENVIRONMENT=production

# Optional CLI RPC overrides and the disposable Sepolia name used by the ENS spike.
MAINNET_RPC_URL=https://your-mainnet-rpc.example
SEPOLIA_RPC_URL=https://your-sepolia-rpc.example
ENS_TEST_NAME=your-disposable-name.eth

# Secrets are deliberately omitted. WORLD_RP_SIGNING_KEY belongs in Convex,
# and ENS_TEST_OWNER_PRIVATE_KEY belongs only in ignored local configuration.
